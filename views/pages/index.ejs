<% if(showForm) { %>
  <a href="/">Close Form</a>
  <%- include("../partials/productForm.ejs", {errors: errors, values: values}); %>
<% } else { %>
  <a href="/new">Create a new product</a>
<% } %>

<% products.forEach((product) => { %>
  <%- include("../partials/product.ejs", {product: product}) %>
  <a href="/product/<%= product.id%>">Details</a>
<% }); %>
